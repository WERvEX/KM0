    {
      "id": "horse",
      "text": "蹩马腿",
      "match": [["马腿"], ["蹩"]]
    },
    {
      "id": "elephant-eye",
      "text": "塞象眼",
      "match": [["象眼"]]
    },
    {
      "id": "elephant-river",
      "text": "象不能过河",
      "match": [["象", "河"], ["相", "河"]]
    },
    {
      "id": "cannon",
      "text": "炮隔子吃",
      "match": [["炮", "隔"], ["炮", "炮架"]]
    },
    {
      "id": "generals",
      "text": "将帅照面",
      "match": [["照面"], ["对脸"]]
    },
    {
      "id": "self-check",
      "text": "走后被将军为非法",
      "match": [["将军"], ["被将"]]
    }
  ]
