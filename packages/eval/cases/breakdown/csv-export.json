{
  "id": "csv-export",
  "why": "需求里写死的格式（列顺序、BOM、日期格式）容易被概括成“导出 CSV”而丢失。",
  "language": "zh-CN",
  "path": "light",
  "title": "订单导出 CSV",
  "description": "后台订单列表加“导出 CSV”按钮。格式要求：表头依次为 订单号,下单时间,金额,状态；文件以 UTF-8 BOM 开头，方便 Excel 打开；下单时间用 ISO 8601（例如 2026-01-31T08:00:00+08:00）；金额保留两位小数；只导出当前筛选条件下的订单。",
  "criteria": [
    {
      "id": "header",
      "text": "表头顺序",
      "match": [["订单号", "下单时间", "金额", "状态"]]
    },
    {
      "id": "bom",
      "text": "UTF-8 BOM",
      "match": [["bom"]]
    },
    {
      "id": "iso",
      "text": "ISO 8601 时间",
      "match": [["iso"], ["8601"]]
    },
    {
      "id": "decimals",
      "text": "金额两位小数",
      "match": [["两位"], ["2 位"]]
    },
    {
      "id": "filter",
      "text": "按当前筛选导出",
      "match": [["筛选"], ["过滤"]]
    }
  ]
}
